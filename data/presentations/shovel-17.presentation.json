{
 "schema": "shot-presentation/1",
 "presentation_id": "presentation.shovel-17.v1",
 "trace_id": "trace.shovel-17.v2",
 "note": "Iteration 24. Presentation only: which source time of the accepted trace each frame shows, plus captions and one marker. Physical motion, contacts and speeds come from data/traces/shovel-17.trace.json unchanged. Replay speed and pauses are presentation choices.",
 "fps": 30,

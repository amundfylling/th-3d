{
  "name": "stiga-play-off-21",
  "version": "0.0.0",
  "private": true,
  "description": "Geometry data and static diagnostics for STIGA Play Off 21 shot videos",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node scripts/smoke.ts",
    "validate": "node scripts/validate-geometry.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm run validate && npm test",
    "trace:board": "node scripts/trace-board.ts",
    "render:board": "node scripts/render-board-overlay.ts",
    "trace:slots": "node scripts/trace-slots.ts",
    "render:tracks06": "node scripts/render-tracks-overlay.ts validation/06-straight-tracks.svg \"06 - Defender and centre slots\" W-LD,W-RD,W-C,E-LD,E-RD,E-C",
    "render:tracks07": "node scripts/render-tracks-overlay.ts validation/07-winger-tracks.svg \"07 - Winger slots\" W-LW,W-RW,E-LW,E-RW --samples",
    "trace:goals": "node scripts/trace-goals.ts",
    "render:goals08": "node scripts/render-goals-overlay.ts",
    "render:pose09": "node scripts/render-pose-debug.ts",
    "players:frames": "/root/venvs/blender/bin/python scripts/extract-player-frames.py",
    "players:preview": "/root/venvs/blender/bin/python assets/blender/preview_molds.py",
    "players:fit": "/root/venvs/blender/bin/python scripts/fit-figure-views.py skater && /root/venvs/blender/bin/python scripts/fit-figure-views.py goalie",
    "players:overhead": "/root/venvs/blender/bin/python scripts/fit-figure-overhead.py",
    "blender:figures": "/root/venvs/blender/bin/python assets/blender/build_figures.py",
    "players:heldout": "/root/venvs/blender/bin/python scripts/fit-figure-views.py skater --heldout && /root/venvs/blender/bin/python scripts/fit-figure-views.py goalie --heldout",
    "players:independent": "/root/venvs/blender/bin/python scripts/fit-figure-views.py skater --independent --fixed && /root/venvs/blender/bin/python scripts/fit-figure-views.py goalie --independent --fixed",
    "players:closeups": "/root/venvs/blender/bin/python assets/blender/render_closeups.py",
    "players:summary": "python3 scripts/closeup-summary.py && /root/venvs/blender/bin/python assets/blender/render_goalie_dims.py",
    "players:define": "node scripts/define-figure-molds.ts",
    "blender:rink": "/root/venvs/blender/bin/python assets/blender/build_rink.py && /root/venvs/blender/bin/python assets/blender/verify_rink.py",
    "blender:hardware": "/root/venvs/blender/bin/python assets/blender/build_hardware.py",
    "assembly:poses": "node scripts/assembly-poses.ts",
    "blender:assembly": "/root/venvs/blender/bin/python assets/blender/build_assembly.py",
    "blender:materials": "/root/venvs/blender/bin/python assets/blender/make_ice_texture.py && /root/venvs/blender/bin/python assets/blender/drop_sponsors.py && /root/venvs/blender/bin/python assets/blender/build_materials.py",
    "blender:appearance": "/root/venvs/blender/bin/python assets/blender/build_appearance.py && /root/venvs/blender/bin/python assets/blender/render_appearance.py",
    "remotion:assets": "mkdir -p public && cp assets/scene/full_static_appearance.glb public/ && node scripts/shot23-manifest.ts",
    "remotion:studio": "npm run remotion:assets && remotion studio remotion/index.ts",
    "remotion:stills": "npm run remotion:assets && for c in oblique overhead side checks; do remotion still remotion/index.ts static-$c out/19-$c.png --frame=0 --browser-executable=/opt/pw-browsers/chromium_headless_shell-1194/chrome-linux/headless_shell --gl=swangle; done",
    "review:20": "node scripts/review-reprojection.ts && python3 scripts/review-sheet.py",
    "shot:21": "/root/venvs/blender/bin/python scripts/shot21-observe.py",
    "shot:22": "/root/venvs/blender/bin/python scripts/shot22-trace.py",
    "shot:23": "npm run remotion:assets && node scripts/shot23-render.ts && python3 scripts/shot23-sheet.py",
    "shot:24": "npm run remotion:assets && node scripts/shot24-render.ts && python3 scripts/shot24-sheet.py",
    "video:shovel-17": "npm run remotion:assets && node scripts/shot25-export.ts && /root/venvs/blender/bin/python scripts/shot25-review.py validation/25-shovel-17-final.mp4 validation/25-final-review.png"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.186.0",
    "jpeg-js": "0.4.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@react-three/fiber": "9.4.0",
    "@remotion/cli": "4.0.531",
    "@remotion/three": "4.0.531",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.531",
    "three": "0.186.1"
  }
}
